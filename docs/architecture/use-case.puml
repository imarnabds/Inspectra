@startuml
!theme plain
title Inspectra - Use Case Diagram

actor "Network Administrator" as Admin
actor "Security Analyst" as Analyst
actor "System Operator / Developer" as Dev

rectangle "Inspectra System Boundary" {
    usecase "Ingest & Parse Offline PCAPs" as UC1
    usecase "Dissect Multi-Layer Protocols (L2-L4)" as UC2
    usecase "Extract Encrypted Metadata (TLS SNI, HTTP, DNS)" as UC3
    usecase "Classify Applications (16+ Services)" as UC4
    usecase "Maintain 5-Tuple Flows & TCP States" as UC5
    usecase "Configure Policies (Block IP/Port/App/Domain)" as UC6
    usecase "Generate Filtered Output PCAPs" as UC7
    usecase "Detect SYN Floods & Threat Anomalies" as UC8
    usecase "Inspect Hex / ASCII Byte Streams" as UC9
    usecase "Export Telemetry (JSON / CSV)" as UC10
    usecase "Synthesize Custom Test Traffic" as UC11
    usecase "ML Behavioral Anomaly Scoring (Planned)" as UC12
}

Admin --> UC1
Admin --> UC6
Admin --> UC7
Admin --> UC10

Analyst --> UC1
Analyst --> UC2
Analyst --> UC3
Analyst --> UC4
Analyst --> UC8
Analyst --> UC9
Analyst --> UC10
Analyst ..> UC12

Dev --> UC1
Dev --> UC5
Dev --> UC6
Dev --> UC11

@enduml
